{
  "name": "unfoldr",
  "version": "0.1.0",
  "private": true,
  "description": "Unfoldr \u2014 offline HTML & Markdown exporter for Notion (Chrome extension). Not affiliated with Notion Labs, Inc.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build && node scripts/build-content.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs",
    "watch": "node scripts/watch.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "jszip": "3.10.2"
  }
}
