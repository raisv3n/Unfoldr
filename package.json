{
  "name": "notion-exporter-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Personal-use Chrome extension that exports Notion pages and connected content to an offline HTML or Markdown ZIP archive.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build && node scripts/build-content.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs",
    "watch": "node scripts/watch.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "jsdom": "26.1.0",
    "puppeteer-core": "25.15.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "jszip": "3.10.1"
  }
}
